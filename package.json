{
  "name": "novly",
  "version": "1.0.0",
  "description": "Novly - plataforma privada de leitura e escrita",
  "main": "worker/index.mjs",
  "scripts": {
    "dev": "npm run build:client && wrangler dev",
    "dev:client": "npm --prefix client run dev",
    "build:client": "npm --prefix client run build",
    "deploy": "npm run build:client && wrangler deploy",
    "cf:db:local": "wrangler d1 migrations apply novly-db --local",
    "cf:db:remote": "wrangler d1 migrations apply novly-db --remote",
    "cf:tail": "wrangler tail",
    "test": "node --test tests/*.test.js",
    "check:server": "node scripts/check-server.js",
    "cf:db:export": "wrangler d1 export novly-db --remote --output=novly-d1-backup.sql"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "5.2.1",
    "jsonwebtoken": "9.0.3",
    "multer": "2.2.0",
    "cookie-parser": "1.4.7"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "devDependencies": {
    "wrangler": "4.44.0"
  }
}
